{
  "name": "doenit",
  "private": false,
  "version": "1.4.5",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host app.doenit.com --port 2001",
    "build": "vite build --mode production",
    "build:dev": "NODE_ENV=development vite build --mode development",
    "build:prod": "NODE_ENV=production vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.53.4",
    "@tailwindcss/vite": "^4.1.18",
    "@types/pako": "^2.0.4",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "svelte": "^5.53.9",
    "svelte-check": "^4.4.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.0.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor-firebase/messaging": "^8.0.1",
    "@capacitor-firebase/storage": "^8.0.1",
