    "@capacitor/share": "^8.0.0",
    "@capawesome/capacitor-google-sign-in": "^0.1.1",
    "cordova-plugin-purchase": "^13.12.1",
    "dexie": "^4.2.1",
    "dotenv": "^17.2.3",
    "firebase": "12.8.0",
    "pako": "^2.1.0",
    "rxdb": "^16.21.1"
